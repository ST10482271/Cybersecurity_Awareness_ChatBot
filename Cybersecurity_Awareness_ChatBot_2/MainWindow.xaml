<Window x:Class="Cybersecurity_Awareness_ChatBot_2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cybersecurity_Awareness_ChatBot_2"
        mc:Ignorable="d"
        Title="MainWindow" Height="401" Width="800" 
        AllowsTransparency="True" Background="Transparent"
        WindowStyle="None" ResizeMode="NoResize">
    
    <Grid Height="434" VerticalAlignment="Top">
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid
            x:Name="logo_grid"
            Visibility="Visible"
            
            > <!--Start of logo grid-->

            <Border CornerRadius="10">
                <Border.Background>
                    <LinearGradientBrush>
                        <GradientStop Color="#0041C2" Offset="0"/>
                        <GradientStop Color="#8a00c2" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>



            <Image  
            Source="\logo1.png"
            Height="250"
            Width="300"
            Margin="0,0,0,150"
          />

            <Button 
            Height="50"
            Width="100"
            Margin="0,200,0,0"
            Background="White"
            Content= "Start CSABot"
            Click="start_bot"
          />

        </Grid> <!--End of logo grid-->

        <Grid  
            x:Name="username_grid"
            Visibility= "Hidden"
            > <!--start of username grid-->

            <Border CornerRadius="10">
                <Border.Background>
                    <LinearGradientBrush>
                        <GradientStop Color="#79BAEC" Offset="0"/>
                        <GradientStop Color="#CEA2FD" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <StackPanel Margin= "10,0,30,0"
             VerticalAlignment="Center"
            >

                <TextBlock 
                  Text=" Please enter your name: "
                  FontSize="16"
                  Margin="0,0,0,10"/>

                <TextBox x:Name ="txtNameInput"
                 Height="25"
                 Padding="3"
                 Margin="0,0,0,10"/>

                <Button x:Name="btnSubmit"
                 Content="Submit" 
                 Width="100" 
                 Height="30"
                 Margin="0,0,0,15"
                 Background="White"
                 HorizontalAlignment="Left"
                 Click="btnSubmit_Click"/>

                <TextBlock x:Name="txtFeedback"
                  FontSize="16"
                  FontWeight="SemiBold"
                  TextWrapping="Wrap" Height="24"/>

            </StackPanel>
            
        </Grid> <!--End of username grid-->




        <Grid  
            x:Name="chats_grid"
            Visibility= "Hidden"
            
            ><!--start of chats grid-->

            <Border CornerRadius="10">
                <Border.Background>
                    <LinearGradientBrush>
                        <GradientStop Color="#79BAEC" Offset="0"/>
                        <GradientStop Color="#CEA2FD" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>


            <ScrollViewer x:Name="ChatScrollViewer"
                
             Grid.Row="1" 
             VerticalScrollBarVisibility="Auto"
             HorizontalAlignment="Left" Width="800">

                <StackPanel x:Name="ChatStackPanel"  Width="800" Height="250"  Margin="0,0,0,150" RenderTransformOrigin="0.499,1.355">

                 <TextBox x:Name="ChatArea"
                 Background="Transparent" 
                 Foreground="Black"
                 FontSize = "15"
                 Width="800" 
                 Height="250"
                 IsReadOnly="True"
                 TextWrapping="Wrap" 
                 Margin="0,0,0,150" RenderTransformOrigin="0.499,1.355"/>
                </StackPanel>

            </ScrollViewer>

            <StackPanel 
             Grid.Row="2" 
             Orientation="Horizontal" 
             Margin="0,0,10,0" 
             >

            <TextBox x:Name="InputArea" 
             Background="White"
             Width="668" 
             Height="57" 
             Margin="0,250,0,0"
             />

            <Button Content="Send" 
             Width="100" 
             Height="30"
             Margin="10,250,0,0"
             Background="White"
             Click="SendButton_Click"/>

            </StackPanel>


        </Grid>
        
        
       

    </Grid>
</Window>
